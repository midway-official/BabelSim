field U
{
    type vector
    location cell
    internal uniform (0 0 0)
    boundary
    {
        inlet { type fixedValue value (1 0 0) }
        outlet { type zeroGradient }
        lower_wall { type fixedValue value (0 0 0) }
        upper_wall { type fixedValue value (0 0 0) }
        front { type symmetry }
        back { type symmetry }
    }
}
