maxIterations 1200
velocityRelaxation 0.5
pressureRelaxation 0.3
continuityTolerance 1e-7
velocityTolerance 1e-6
pressureCorrectionTolerance 1e-6
# momentum
equation.momentum.solver bicgstab
equation.momentum.preconditioner ilut
equation.momentum.absoluteTolerance 1e-14
equation.momentum.relativeTolerance 1e-8
equation.momentum.maxIterations 1200
# pressureCorrection
equation.pressureCorrection.solver cg
equation.pressureCorrection.preconditioner incompleteCholesky
equation.pressureCorrection.absoluteTolerance 1e-14
equation.pressureCorrection.relativeTolerance 1e-6
equation.pressureCorrection.maxIterations 1200
