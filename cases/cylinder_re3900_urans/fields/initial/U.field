field U
{
    type vector
    location cell
    internal file U.initial.dat
    boundary
    {
        cylinder { type fixedValue value (0 0 0) }
        inlet { type fixedValue value (1 0 0) }
        outlet { type zeroGradient }
        farfield { type symmetry }
        front { type symmetry }
        back { type symmetry }
    }
}
