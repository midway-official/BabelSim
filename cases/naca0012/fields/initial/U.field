field U
{
    type vector
    location cell
    internal uniform (-1 0 0)
    boundary
    {
        airfoil { type fixedValue value (0 0 0) }
        inlet { type fixedValue value (-1 0 0) }
        outlet { type zeroGradient }
        farfield { type fixedValue value (-1 0 0) }
        front { type symmetry }
        back { type symmetry }
    }
}
