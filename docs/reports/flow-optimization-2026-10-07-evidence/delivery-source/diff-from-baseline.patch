+        else:
+            shutil.copy2(source/rel,dest)
+    assert (target/'control.bs').read_text()=='startTime 0\nendTime 0.1\ndeltaT 0.01\n'
+    (target/'control.bs').write_text('startTime 0\nendTime 0.2\ndeltaT 0.01\n')
