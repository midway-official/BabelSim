+#!/usr/bin/env python3
+"""Create a production flow case on an independently checked partition graph.
+
+The solver dictionaries come from an existing case. Only its mesh is replaced;
+all equation, coupling and convergence controls are retained.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+from benchmark_backend import case_manifest
+from partition_model_graphs import make_graph, native_fixture
+
+
+BOX_PATCHES = [('inlet', 'inlet'), ('outlet', 'outlet'),
+               ('lower_wall', 'wall'), ('upper_wall', 'wall'),
+               ('front', 'symmetry'), ('back', 'symmetry')]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--template', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--family', choices=('voronoi_prisms', 'graded_voronoi',
+                                            'tet_cube', 'hex_cube'), required=True)
+    parser.add_argument('--scale', choices=('fixture', 'small', 'engineering'),
+                        default='engineering')
+    args = parser.parse_args()
+    template, output = args.template.resolve(), args.output.resolve()
+    if output.exists():
+        parser.error('output already exists; use a new directory')
+    manifest = case_manifest(template)
+    meshes = [entry for entry in manifest['files'] if entry['path'].endswith('.mesh')]
+    if len(meshes) != 1:
+        parser.error('template must contain exactly one native .mesh input')
+    output.mkdir(parents=True)
+    for entry in manifest['files']:
+        if entry == meshes[0] or entry['path'] == 'generation.json':
+            continue
+        relative = Path(entry['path'])
+        target = output / relative
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(template / relative, target)
+    graph = make_graph(args.family, args.scale)
+    graph.validate()
+    mesh = output / meshes[0]['path']
+    mesh.parent.mkdir(parents=True, exist_ok=True)
+    native_fixture(graph, mesh, box_boundary_patches=BOX_PATCHES)
+    graph.save(output / 'dual-graph.npz')
+    info = dict(graph.metadata, template=str(template),
+                templateInputSha256=manifest['sha256'], mesh=str(mesh),
+                meshSha256=hashlib.sha256(mesh.read_bytes()).hexdigest(),
+                csrAndFaceCountsIndependentlyChecked=True,
+                boundaryPlanes=[name for name, role in BOX_PATCHES])
+    (output / 'generation.json').write_text(json.dumps(info, indent=2) + '\n')
+    print(json.dumps(info, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/partition_model_algorithms.py b/tools/partition_model_algorithms.py
new file mode 100644
index 0000000..8f11374
--- /dev/null
+++ b/tools/partition_model_algorithms.py
@@ -0,0 +1,375 @@
+"""Python partition prototypes and compiled graph kernels; no solver access."""
+from __future__ import annotations
+
+import ctypes as ct
+import ctypes.util
+from heapq import heappop, heappush
+from pathlib import Path
+import re
+import numpy as np
+from numba import njit
+
+ALGORITHMS = ('graph-growth', 'rcb', 'rib', 'morton', 'morton-isotropic', 'metis-cut',
+              'metis-cut-work', 'metis-volume-work', 'metis-volume-contig')
+
+
+def quotas(cells, parts):
+    return np.full(parts,cells//parts,dtype=np.int32)+(np.arange(parts)<cells%parts)
+
+
+@njit(cache=True,nogil=True)
+def graph_growth(offsets, neighbours, parts):
+    """Faithful seed/round-robin model of the existing C++ graph partitioner."""
+    cells=len(offsets)-1
+    capacity=np.full(parts,cells//parts,np.int32)
+    for part in range(cells%parts): capacity[part]+=1
+    filled=np.zeros(parts,np.int32)
+    nearest=np.full(cells,2147483647,np.int32)
+    seeded=np.zeros(cells,np.uint8)
+    seeds=np.empty(parts,np.int32)
+    queue=np.empty(cells,np.int32)
+    for part in range(parts):
+        seed=-1
+        for cell in range(cells):
+            if not seeded[cell] and (seed==-1 or nearest[cell]>nearest[seed]): seed=cell
+        seeds[part]=seed; seeded[seed]=1; nearest[seed]=0
+        head,tail=0,1; queue[0]=seed
+        while head<tail:
+            cell=queue[head]; head+=1; distance=nearest[cell]+1
+            for edge in range(offsets[cell],offsets[cell+1]):
+                neighbour=neighbours[edge]
+                if nearest[neighbour]>distance:
+                    nearest[neighbour]=distance; queue[tail]=neighbour; tail+=1
+    owners=np.full(cells,-1,np.int32)
+    following=np.full(cells,-1,np.int32)
+    heads=seeds.copy(); tails=seeds.copy()
+    for part in range(parts): owners[seeds[part]]=part; filled[part]=1
+    remaining=cells-parts
+    while remaining:
+        grew=False
+        for part in range(parts):
+            if filled[part]>=capacity[part]: continue
+            while heads[part]!=-1:
+                cell=heads[part]; selected=-1
+                for edge in range(offsets[cell],offsets[cell+1]):
+                    neighbour=neighbours[edge]
+                    if owners[neighbour]==-1: selected=neighbour; break
+                if selected!=-1:
+                    owners[selected]=part; filled[part]+=1; remaining-=1
+                    following[tails[part]]=selected; tails[part]=selected
+                    grew=True; break
