new file mode 100644
index 0000000..ff7f587
--- /dev/null
+++ b/src/parallel/mesh_partition.cpp
@@ -0,0 +1,430 @@
+#include "internal/mesh_partition.h"
+#include "internal/mesh_access.h"
+
+#ifdef BABELSIM_USE_METIS
+#include <metis.h>
+#endif
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <queue>
+#include <stdexcept>
+#include <tuple>
+#include <vector>
