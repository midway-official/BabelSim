equation.momentum.solver bicgstab
equation.momentum.preconditioner ilut
equation.momentum.absoluteTolerance 1e-16
equation.momentum.relativeTolerance 1e-12
equation.momentum.maxIterations 1000
equation.pressureCorrection.solver cg
equation.pressureCorrection.preconditioner incompleteCholesky
equation.pressureCorrection.absoluteTolerance 1e-16
equation.pressureCorrection.relativeTolerance 1e-12
equation.pressureCorrection.maxIterations 1000
equation.nuTildaTransport.solver bicgstab
equation.nuTildaTransport.preconditioner ilut
equation.nuTildaTransport.absoluteTolerance 1e-16
equation.nuTildaTransport.relativeTolerance 1e-12
equation.nuTildaTransport.maxIterations 1000
